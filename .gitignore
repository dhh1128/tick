__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

# zipapp build artifact (built into dist/, which is ignored above)
*.pyz

# tick's own ledger worktree, created by dogfooding `tick init`
/.tick
.tick.lock

# uv writes this when the project is run/installed with `uv run` / `uv tool
# install .`; tick has zero runtime deps, so the lock pins nothing worth keeping
# and its churn would break release.py's clean-tree check.
uv.lock
